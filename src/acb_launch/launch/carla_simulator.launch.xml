<?xml version="1.0" encoding="UTF-8"?>
<!-- Autoware on CARLA: the Autoware profile for a simulated car (autoware_sim_profile, from
     autoware_sim_vehicle) and acb_bridge, CARLA's vehicle interface, beside it.

     acb_bridge attaches to the CARLA vehicle named vehicle_name and publishes its sensors,
     vehicle status, /clock and V2X signals, and applies Autoware's control. With fusion-only
     traffic lights the traffic light camera is not spawned. Every other argument is the
     profile's (autoware_sim_profile/launch/autoware.launch.xml: max_velocity,
     lidar_detection_model, rviz, gpu, extra_launch, the sim_* switches, ...); given here, it
     reaches the profile.

     Standalone, with CARLA up and a hero spawned (a CARLA client of your own, or
     demo_scenario.py):
       play_launch launch acb_launch carla_simulator.launch.xml map_path:=<town dir>
     scenario-world-bridge starts it with its vehicle agent as extra_launch.
-->
<launch>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="use_sim_time" default="true" description="use simulation time"/>
  <!-- The car: its Autoware packages (autoware_sim_vehicle, generated from its vehicle spec)
       and the sensors acb_bridge spawns for it (sim_vehicle_spec's carla_sensors.yaml), one
       spec for both. -->
  <arg name="vehicle_model" default="tesla_model3" description="vehicle model name (the spec's name)"/>
  <arg name="sensor_model" default="$(var vehicle_model)_sensor_kit" description="sensor model name"/>
  <arg name="vehicle_config" default="$(find-pkg-share sim_vehicle_spec)/generated/$(var vehicle_model)/carla_sensors.yaml"
       description="the sensors acb_bridge spawns: the car's generated carla_sensors.yaml"/>
  <!-- Shared with the profile: fusion-only traffic lights leave the camera unspawned here,
       and ground-truth objects turn object recognition off there. -->
  <arg name="traffic_light_fusion_only" default="true"
       description="skip camera-based traffic light recognition; signals come from acb (V2X)"/>
  <arg name="publish_ground_truth_objects" default="false"/>
  <arg name="vehicle_name" default="hero" description="CARLA role_name of the vehicle acb_bridge attaches to"/>
  <arg name="carla_host" default="localhost"/>
  <arg name="carla_port" default="2000"/>
  <arg name="publish_clock" default="true" description="acb publishes /clock from CARLA in this domain"/>
  <arg name="seed_localization_on_attach" default="true"/>
  <arg name="traffic_light_map_path" default="$(var map_path)/carla/traffic_lights.yaml"
       description="the map dir's CARLA signal table (carla_world --generate-signal-table); empty disables V2X signals"/>
  <arg name="map_origin_path" default="$(var map_path)/carla/map_origin.yaml"
       description="where CARLA's world origin sits in the map frame; no file = zero (TUM towns)"/>
  <arg name="accel_map_path" default="$(find-pkg-share $(var vehicle_model)_description)/config/accel_map.csv"/>
  <arg name="brake_map_path" default="$(find-pkg-share $(var vehicle_model)_description)/config/brake_map.csv"/>
  <arg name="report_measured_steering" default="false"/>
  <arg name="steering_multiplier" default="1.0"/>
  <arg name="steer_rate_limit_deg_s" default="0.0" description="steering actuator rate limit, deg/s; 0 = off"/>
  <arg name="steer_time_constant_s" default="0.0" description="steering first-order lag, s; 0 = off"/>
  <arg name="ground_truth_range_m" default="100.0"/>
  <arg name="control_trace_path" default=""/>
  <arg name="allow_manual" default="false" description="accept a driver's MANUAL takeover (acb_bridge.launch.xml)"/>
  <arg name="honor_emergency_cmd" default="false" description="full brake on emergency_cmd instead of the control command (acb_bridge.launch.xml)"/>
  <arg name="control_cmd_timeout_s" default="1.0" description="brake to a stop when control_cmd is older than this, s of sim time; 0 disables (acb_bridge.launch.xml)"/>
  <!-- carla_world's sensor-release sockets, its ssv2_port + 1 and + 2 (acb_bridge.launch.xml) -->
  <arg name="release_notify_endpoint" default="tcp://127.0.0.1:5556" description="scenario runner's release-notice PUB socket; empty disables"/>
  <arg name="release_ack_endpoint" default="tcp://127.0.0.1:5557" description="scenario runner's release-acknowledgement PULL socket"/>

  <include file="$(find-pkg-share autoware_sim_profile)/launch/autoware.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="traffic_light_fusion_only" value="$(var traffic_light_fusion_only)"/>
    <arg name="publish_ground_truth_objects" value="$(var publish_ground_truth_objects)"/>
  </include>

    <include file="$(find-pkg-share acb_bridge)/launch/acb_bridge.launch.xml">
      <arg name="disabled_sensors" value="$(eval &quot;'camera6/camera_link' if '$(var traffic_light_fusion_only)' == 'true' else ''&quot;)"/>
      <arg name="vehicle_config" value="$(var vehicle_config)"/>
      <arg name="carla_address" value="$(var carla_host)"/>
      <arg name="carla_port" value="$(var carla_port)"/>
      <arg name="vehicle_name" value="$(var vehicle_name)"/>
      <arg name="publish_clock" value="$(var publish_clock)"/>
      <arg name="report_measured_steering" value="$(var report_measured_steering)"/>
      <arg name="steering_multiplier" value="$(var steering_multiplier)"/>
      <arg name="steer_rate_limit_deg_s" value="$(var steer_rate_limit_deg_s)"/>
      <arg name="steer_time_constant_s" value="$(var steer_time_constant_s)"/>
      <arg name="seed_localization_on_attach" value="$(var seed_localization_on_attach)"/>
      <arg name="publish_ground_truth_objects" value="$(var publish_ground_truth_objects)"/>
      <arg name="ground_truth_range_m" value="$(var ground_truth_range_m)"/>
      <arg name="traffic_light_map_path" value="$(var traffic_light_map_path)"/>
      <arg name="map_origin_path" value="$(var map_origin_path)"/>
      <arg name="control_trace_path" value="$(var control_trace_path)"/>
      <arg name="accel_map_path" value="$(var accel_map_path)"/>
      <arg name="brake_map_path" value="$(var brake_map_path)"/>
      <arg name="allow_manual" value="$(var allow_manual)"/>
      <arg name="honor_emergency_cmd" value="$(var honor_emergency_cmd)"/>
      <arg name="control_cmd_timeout_s" value="$(var control_cmd_timeout_s)"/>
      <arg name="release_notify_endpoint" value="$(var release_notify_endpoint)"/>
      <arg name="release_ack_endpoint" value="$(var release_ack_endpoint)"/>
    </include>
</launch>
