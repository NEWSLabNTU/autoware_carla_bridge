<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acb_launch</name>
  <version>0.1.0</version>
  <description>Autoware on CARLA: the Autoware profile (autoware_sim_profile) with acb_bridge</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>autoware_sim_profile</exec_depend>
  <exec_depend>acb_bridge</exec_depend>
  <exec_depend>sim_vehicle_spec</exec_depend>
  <exec_depend>tesla_model3_description</exec_depend>
  <exec_depend>tesla_model3_launch</exec_depend>
  <exec_depend>tesla_model3_sensor_kit_description</exec_depend>
  <exec_depend>tesla_model3_sensor_kit_launch</exec_depend>
  <exec_depend>individual_params</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
