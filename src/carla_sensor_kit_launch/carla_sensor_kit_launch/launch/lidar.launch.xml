<launch>
  <!--
    CARLA Bridge LiDAR Launch

    This launch file configures the LiDAR processing pipeline for CARLA simulation.
    Unlike hardware sensor kits, no velodyne drivers are needed since CARLA bridge
    publishes point cloud data directly to ROS topics.

    The bridge publishes to /sensing/lidar/top/pointcloud_before_sync (based on URDF link name),
    which is consumed by the pointcloud_preprocessor concatenation node.

    Note - CARLA uses a single top LiDAR for performance (see sensor_kit.xacro comments).
  -->

  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="use_distortion_corrector" default="false"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <!--
      No velodyne driver includes needed - CARLA bridge publishes directly.
      The bridge publishes to /sensing/lidar/top/pointcloud_before_sync based on URDF link names.
    -->

    <!-- Pointcloud concatenation (even with single LiDAR, this is needed for downstream) -->
    <include file="$(find-pkg-share carla_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    </include>
  </group>
</launch>
