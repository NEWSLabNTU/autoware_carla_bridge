#!/usr/bin/env python3
"""Print the planning common parameter file for a max velocity, writing it if needed.

    planning_common_param <upstream common.param.yaml> <max_velocity m/s>

autoware_launch's common.param.yaml caps every planner at its max_vel (4.17 m/s, 15 km/h);
the external velocity limit (a scenario's SpeedAction) cannot raise it. carla_simulator's
max_velocity argument reaches the planners through this script, run by a $(command)
substitution while the launch is resolved:

- max_velocity equal to upstream's max_vel: prints upstream's path unchanged, so the
  default stack loads exactly upstream's file;
- otherwise: writes upstream's file with only the max_vel line changed to
  $XDG_CACHE_HOME/acb_launch/common.param.max_vel-<v>.yaml (~/.cache when unset) and prints
  that path.

Prints the path with no newline and nothing on stderr on success (a $(command)
substitution fails on stderr output). Exits 2 on a bad argument or an upstream file whose
max_vel line it does not recognise (scripts/sync_planning_component.sh --check guards the
same line).
"""

import os
import re
import sys
import tempfile

MAX_VEL = re.compile(r"^(    max_vel: )([0-9.]+)( .*)?$", re.MULTILINE)


def derive(upstream_text, max_velocity):
    """upstream_text with its max_vel set to max_velocity, or None when it already is."""
    found = MAX_VEL.findall(upstream_text)
    if len(found) != 1:
        raise ValueError(f"expected one '    max_vel: <number>' line, found {len(found)}")
    if float(found[0][1]) == max_velocity:
        return None
    header = (
        "# GENERATED by acb_launch planning_common_param from autoware_launch's\n"
        "# config/planning/scenario_planning/common/common.param.yaml; do not edit.\n"
        f"# Only change: max_vel is {max_velocity!r} (carla_simulator.launch.xml max_velocity).\n"
    )
    return header + MAX_VEL.sub(lambda m: f"{m.group(1)}{max_velocity!r}{m.group(3) or ''}",
                                upstream_text)


def main(argv):
    if len(argv) != 3:
        sys.exit(f"usage: {argv[0]} <upstream common.param.yaml> <max_velocity m/s>")
    upstream, value = argv[1], argv[2]
    try:
        max_velocity = float(value)
    except ValueError:
        print(f"max_velocity must be a number of m/s, got '{value}'", file=sys.stderr)
        return 2
    if not max_velocity > 0.0 or max_velocity != max_velocity or max_velocity == float("inf"):
        print(f"max_velocity must be positive and finite, got '{value}'", file=sys.stderr)
        return 2
    with open(upstream) as f:
        text = f.read()
    try:
        derived = derive(text, max_velocity)
    except ValueError as e:
        print(f"{upstream}: {e}", file=sys.stderr)
        return 2
    if derived is None:
        sys.stdout.write(upstream)
        return 0
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    out_dir = os.path.join(cache, "acb_launch")
    os.makedirs(out_dir, exist_ok=True)
    out = os.path.join(out_dir, f"common.param.max_vel-{max_velocity!r}.yaml")
    # Atomic: two stacks resolving at once never read a half-written file.
    fd, tmp = tempfile.mkstemp(dir=out_dir, prefix=".common.param.")
    with os.fdopen(fd, "w") as f:
        f.write(derived)
    os.replace(tmp, out)
    sys.stdout.write(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
