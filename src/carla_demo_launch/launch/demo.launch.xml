<?xml version="1.0" encoding="UTF-8"?>
<!-- CARLA Demo Launch
     Launches the full CARLA + Autoware + bridge demo stack in one command.

     Components launched:
     1. CARLA simulator (executable)
     2. Autoware planning simulator (via carla_simulator.launch.xml)
     3. CARLA-Autoware bridge (via autoware_carla_bridge.launch.xml)
     4. Demo scenario - loads map and configures CARLA (executable)
     5. Autonomous driving pilot (node)
     6. Manual control monitor GUI (node)
-->
<launch>
  <!-- Required args -->
  <arg name="project_dir" description="Project root directory"/>

  <!-- Configurable args with defaults matching justfile -->
  <arg name="carla_version" default="0.9.16" description="CARLA version"/>
  <arg name="carla_port" default="2000" description="CARLA RPC port"/>
  <arg name="map_name" default="Town01" description="CARLA map name"/>

  <!-- 1. CARLA simulator -->
  <executable
    cmd="$(var project_dir)/third_party/carla/carla-$(var carla_version)/CarlaUE4.sh -quality-level=Low -carla-rpc-port=$(var carla_port)"
    output="screen"
    name="carla_simulator">
    <env name="VK_ICD_FILENAMES" value="/usr/share/vulkan/icd.d/nvidia_icd.json"/>
  </executable>

  <!-- 2. Autoware planning simulator -->
  <include file="$(find-pkg-share carla_autoware_launch)/launch/carla_simulator.launch.xml">
    <arg name="map_path" value="$(var project_dir)/data/carla-autoware-bridge/$(var map_name)"/>
    <arg name="vehicle_model" value="carla_vehicle"/>
    <arg name="sensor_model" value="carla_sensor_kit"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- 3. CARLA-Autoware bridge -->
  <include file="$(find-pkg-share autoware_carla_bridge)/launch/autoware_carla_bridge.launch.xml">
    <arg name="carla_port" value="$(var carla_port)"/>
  </include>

  <!-- 4. Demo scenario - loads map and configures CARLA -->
  <executable
    cmd="$(var project_dir)/scripts/demo_scenario.py --port $(var carla_port) --map $(var map_name)"
    output="screen"
    name="demo_scenario"/>

  <!-- 5. Autonomous driving pilot -->
  <node pkg="carla_pilot" exec="drive" name="drive_pilot" output="screen">
    <param name="poses_file" value="$(var project_dir)/scripts/poses.json"/>
  </node>

  <!-- 6. Manual control monitor GUI -->
  <node pkg="manual_control" exec="manual_control" name="manual_control" output="screen">
    <env name="CARLA_VERSION" value="$(var carla_version)"/>
  </node>
</launch>
