<?xml version="1.0" encoding="UTF-8"?>
<!-- CARLA Demo Launch
     Launches Autoware + bridge + scenario + pilot + monitor.
     CARLA must be started separately via `just carla-start`.

     Components launched:
     1. Autoware planning simulator (via carla_simulator.launch.xml)
     2. CARLA-Autoware bridge (via autoware_carla_bridge.launch.xml)
     3. Demo scenario - loads map and configures CARLA (executable)
     4. Autonomous driving pilot (node)
     5. Manual control monitor GUI (node)
-->
<launch>
  <!-- Required args -->
  <arg name="project_dir" description="Project root directory"/>

  <!-- Configurable args with defaults matching justfile -->
  <arg name="carla_port" default="2000" description="CARLA RPC port"/>
  <arg name="map_name" default="Town01" description="CARLA map name"/>
  <arg name="data_path" default="/opt/autoware/1.5.0/data" description="Autoware ML models and data directory"/>

  <!-- 1. Autoware planning simulator -->
  <include file="$(find-pkg-share carla_autoware_launch)/launch/carla_simulator.launch.xml">
    <arg name="map_path" value="$(var project_dir)/data/carla-autoware-bridge/$(var map_name)"/>
    <arg name="vehicle_model" value="carla_vehicle"/>
    <arg name="sensor_model" value="carla_sensor_kit"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="data_path" value="$(var data_path)"/>
  </include>

  <!-- 2. CARLA-Autoware bridge -->
  <include file="$(find-pkg-share autoware_carla_bridge)/launch/autoware_carla_bridge.launch.xml">
    <arg name="carla_port" value="$(var carla_port)"/>
  </include>

  <!-- 3. Demo scenario - loads map and configures CARLA -->
  <executable
    cmd="$(var project_dir)/scripts/demo_scenario.py --port $(var carla_port) --map $(var map_name)"
    output="screen"
    name="demo_scenario"/>

  <!-- 4. Autonomous driving pilot -->
  <node pkg="carla_pilot" exec="auto_drive" name="auto_drive" output="screen">
    <param name="poses_file" value="$(find-pkg-share carla_pilot)/config/example_poses.yaml"/>
    <param name="wait_for_arrival" value="false"/>
  </node>

  <!-- 5. Manual control monitor GUI -->
  <node pkg="manual_control" exec="manual_control" name="manual_control" output="screen"/>
</launch>
