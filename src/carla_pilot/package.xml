<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_pilot</name>
  <version>0.1.0</version>
  <description>Autonomous driving pilot and pose reader nodes for CARLA-Autoware</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
