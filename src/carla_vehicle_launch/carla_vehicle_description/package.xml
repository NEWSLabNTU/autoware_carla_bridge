<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_vehicle_description</name>
  <version>0.1.0</version>
  <description>
    Vehicle description package for CARLA simulation with Autoware.
    Provides vehicle dimensions, URDF, and visualization for CARLA vehicles.
  </description>
  <maintainer email="noreply@example.com">Autoware CARLA Bridge</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
