<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_sensor_kit_launch</name>
  <version>0.1.0</version>
  <description>
    Sensor kit launch package for CARLA simulation with Autoware.
    Provides sensor processing pipelines (bridge publishes raw data).
  </description>
  <maintainer email="noreply@example.com">Autoware CARLA Bridge</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <!-- Sensor data processing nodes (bridge provides raw sensor data) -->
  <exec_depend>autoware_imu_corrector</exec_depend>
  <exec_depend>autoware_gnss_poser</exec_depend>
  <exec_depend>autoware_pointcloud_preprocessor</exec_depend>
  <exec_depend>vehicle_velocity_converter</exec_depend>

  <!-- Note: Hardware sensor drivers NOT needed (bridge handles sensor data):
       - tamagawa_imu_driver (IMU hardware driver)
       - ublox_gps (GNSS hardware driver)
       - usb_cam (camera hardware driver)
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
