#!/usr/bin/env bash
# direnv configuration for autoware_carla_bridge

# Source ROS 2 Humble
source /opt/ros/humble/setup.bash

# Source Autoware if it exists
if [ -f third_party/autoware/autoware_repo/install/setup.bash ]; then
    watch_file third_party/autoware/autoware_repo/install/setup.bash
    source third_party/autoware/autoware_repo/install/setup.bash
    echo "✓ Sourced third_party/autoware/autoware_repo/install/setup.bash"
fi

# Optionally source local colcon install if it exists
# This provides access to built ROS packages and environment
if [ -f install/setup.bash ]; then
    watch_file install/setup.bash
    source install/setup.bash
    echo "✓ Sourced install/setup.bash"
else
    # Watch for the file to appear (after first build)
    watch_file install/setup.bash
    echo "install/setup.bash not found (run 'make build' to create it)"
fi

# Set DISPLAY for CARLA (VNC display)
export DISPLAY=:1

# Set RMW_IMPLEMENTATION
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Optionally set CARLA_VERSION for multi-version support
# Uncomment to use a specific CARLA version:
# export CARLA_VERSION=0.9.16  # Default
# export CARLA_VERSION=0.9.15
# export CARLA_VERSION=0.9.14
