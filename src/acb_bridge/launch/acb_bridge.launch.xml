<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- CARLA connection parameters -->
  <arg name="carla_address" default="127.0.0.1" description="CARLA server address"/>
  <arg name="carla_port" default="2000" description="CARLA server port"/>

  <!-- Vehicle identification -->
  <arg name="vehicle_name" default="hero" description="CARLA vehicle role_name to attach to"/>

  <!-- Vehicle configuration (single source of truth for sensors) -->
  <arg name="vehicle_config" default="$(find-pkg-share acb_bridge)/config/vehicle_config.yaml"
       description="Path to vehicle configuration YAML file"/>

  <!-- Clock ownership. Set false in the scenario ego's domain, where SSv2 publishes
       /clock; two publishers make localization log "Detected jump back in time". -->
  <!-- Where carla_scenario_bridge announces upcoming despawns, so this bridge can stop
       its sensors before they are destroyed underneath it. Must match that bridge's
       sensor_release.notify_endpoint / ack_endpoint. Empty notify endpoint disables it.
       See docs/issues/015. -->
  <arg name="release_notify_endpoint" default="tcp://127.0.0.1:5556"
       description="Scenario runner's release-notice PUB socket"/>
  <arg name="release_ack_endpoint" default="tcp://127.0.0.1:5557"
       description="Scenario runner's release-acknowledgement PULL socket"/>
  <!-- Echo the command by default. Reporting the measured wheel angle is truthful but
       destabilises the lateral controller until the command mapping is calibrated
       against it; see docs/issues/009. -->
  <arg name="report_measured_steering" default="false"
       description="Report the measured wheel angle (true) or echo the command (false)"/>
  <!-- Trim on the steering command. 1.0 is correct for the blueprints measured so far; the
       Ackermann inverse comes from physics_control, so a blueprint whose tyres or steering
       curve differ from the geometry can still under- or over-steer against it. Calibrate
       against measured wheel angles, not scenario outcomes. See docs/issues/006. -->
  <arg name="steering_multiplier" default="1.0"
       description="Scale factor on the normalized steering command (1.0 = no trim)"/>
  <!-- Report CARLA's actors as perception output instead of deriving them from the LiDAR.
       Only correct with Autoware's own perception disabled (perception:=false), or two
       publishers interleave on /perception/object_recognition/objects. -->
  <arg name="seed_localization_on_attach" default="true"
       description="Re-seed Autoware's pose estimator when attaching, if its estimate is
                    somewhere other than this vehicle. Only acts on an estimate that
                    already exists, so a cold start is left to Autoware's own initializer." />
  <arg name="publish_ground_truth_objects" default="false"
       description="Publish CARLA actors as PredictedObjects, bypassing perception"/>
  <arg name="ground_truth_range_m" default="100.0"
       description="Ground-truth objects further than this from the ego are not published"/>
  <!-- Measured pedal response. Empty falls back to a single-constant conversion, which
       measurement shows to be wrong by a factor of two at full throttle. -->
  <arg name="control_trace_path" default=""
       description="Write per-stage control latency here as CSV; empty disables it"/>
  <arg name="accel_map_path"
       default="$(find-pkg-share acb_vehicle_description)/config/accel_map.csv"
       description="Throttle response table: pedal x speed -> acceleration"/>
  <arg name="brake_map_path"
       default="$(find-pkg-share acb_vehicle_description)/config/brake_map.csv"
       description="Brake response table: pedal x speed -> acceleration"/>
  <arg name="publish_clock" default="true"
       description="Publish /clock from CARLA simulation time"/>

  <!-- Launch the bridge node with ROS parameters -->
  <node pkg="acb_bridge" name="acb_bridge" exec="acb_bridge" output="screen">
    <param name="carla_address" value="$(var carla_address)"/>
    <param name="carla_port" value="$(var carla_port)"/>
    <param name="vehicle_name" value="$(var vehicle_name)"/>
    <param name="vehicle_config" value="$(var vehicle_config)"/>
    <param name="publish_clock" value="$(var publish_clock)"/>
    <param name="release_notify_endpoint" value="$(var release_notify_endpoint)"/>
    <param name="release_ack_endpoint" value="$(var release_ack_endpoint)"/>
    <param name="report_measured_steering" value="$(var report_measured_steering)"/>
    <param name="steering_multiplier" value="$(var steering_multiplier)"/>
    <param name="publish_ground_truth_objects" value="$(var publish_ground_truth_objects)"/>
    <param name="seed_localization_on_attach" value="$(var seed_localization_on_attach)"/>
    <param name="ground_truth_range_m" value="$(var ground_truth_range_m)"/>
    <param name="control_trace_path" value="$(var control_trace_path)"/>
    <param name="accel_map_path" value="$(var accel_map_path)"/>
    <param name="brake_map_path" value="$(var brake_map_path)"/>
  </node>
</launch>
