*.py[oc]

# Colcon build artifacts
build/
install/
log/
.cargo/

# direnv
.direnv/

# Machine-specific environment
.env

# Downloaded data (maps, etc.)
/data/

# Packaging artifacts
staging/
pkg_install/
*.deb
