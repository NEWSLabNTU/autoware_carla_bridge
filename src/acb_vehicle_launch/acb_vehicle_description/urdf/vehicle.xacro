<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    CARLA Vehicle URDF - Visualization Only

    This URDF defines the vehicle visualization for RViz and provides the base_link frame.
    The actual vehicle physics, dynamics, and collision are handled by CARLA simulator.

    The mesh is positioned with its center at the rear axle (base_link origin).
    Sensor kit URDF will attach sensors relative to this base_link frame.
  -->

  <!-- Load vehicle dimensions from vehicle_info.param.yaml -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find acb_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- Vehicle body visualization -->
  <link name="base_link">
    <visual>
      <!-- Position mesh at center of wheelbase/2 (rear axle is base_link origin) -->
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']/2.0} 0 0" rpy="${pi/2.0} 0 ${pi}"/>
      <geometry>
        <!-- Lexus RX450h mesh from AWSIM Labs (can be replaced with CARLA-specific mesh) -->
        <mesh filename="package://acb_vehicle_description/mesh/lexus.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
</robot>
